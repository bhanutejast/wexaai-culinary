# CognoDB / Neo4j Graph Database Credentials
# Obtain these from your CognoDB Cloud dashboard or use a local Neo4j instance.
COGNODB_URI=bolt://localhost:7687
COGNODB_USERNAME=neo4j
COGNODB_PASSWORD=password

# Fallback to local memory-mock database if CognoDB is not available.
# Set to false to force database connections and fail if database is offline.
COGNODB_MOCK_FALLBACK=true

# Server Configuration
HOST=127.0.0.1
PORT=8000
